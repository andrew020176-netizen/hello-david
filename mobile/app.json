{
  "expo": {
    "name": "Stuff the Shopping",
    "slug": "stuff-the-shopping",
    "scheme": "stuffshopping",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F7F1E3",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "au.com.stufftheshopping.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Stuff the Shopping uses the microphone only when you tap to talk so it can turn what you say into your grocery list."
      }
    },
    "android": {
      "package": "au.com.stufftheshopping.app",
      "versionCode": 1,
      "permissions": ["RECORD_AUDIO"]
    }
  }
}
